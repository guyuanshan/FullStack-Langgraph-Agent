{"timestamp":"2026-05-19T13:23:41.122Z","sessionId":"c2c3dfee-52e1-4e0f-8e52-020903cc08b4","toolName":"fs_read_text","toolCallId":"call_00_OBpdP3z8znk2wlXKEJgA2844","source":"mcp","riskLevel":"safe","permissions":["read"],"args":{"filePath":"prisma/schema.prisma"},"outcome":"success","latencyMs":45,"detail":"{\"filePath\":\"prisma/schema.prisma\",\"content\":\"generator client {\\n  provider = \\\"prisma-client-js\\\"\\n  output   = \\\"../src/generated/prisma\\\"\\n}\\n\\ndatasource db {\\n  provider = \\\"sqlite\\\"\\n  url      = env(\\\"DATABASE_URL\\\")\\n}\\n\\nmodel User {\\n  id        String    @id @default(cuid())\\n  email     String?   @unique\\n  name      String?\\n  createdAt DateTime  @default(now())\\n  updatedAt DateTime  @updatedAt\\n  sessions  Session[]\\n}\\n\\nmodel Session {\\n  id               String                 @id\\n  userId           String?\\n  title            String?\\n  summary          String?\\n  summaryUpdatedAt DateTime?\\n  messageCount     Int                    @default(0)\\n  lastMessageAt    DateTime?\\n  createdAt        DateTime               @default(now())\\n  updatedAt        DateTime               @updatedAt\\n  user             User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)\\n  messages         Message[]\\n  toolCalls        ToolCall[]\\n  checkpoints      Checkpoint[]\\n  auditLogs        AuditLog[]\\n  agentTraces      AgentTrace[]\\n}\\n\\nmodel ProjectMemory {\\n  id          String   @id @default(cuid())\\n  projectId   String\\n  type        String\\n  sourcePath  String?\\n  chunkKey    String\\n  title       String?\\n  content     String\\n  embedding   String\\n  metadataJson String?\\n  contentHash String\\n  createdAt   DateTime @default(now())\\n  updatedAt   DateTime @updatedAt\\n\\n  @@unique([projectId, chunkKey])\\n  @@index([projectId, type, updatedAt])\\n  @@index([projectId, sourcePath])\\n}\\n\\nmodel Message {\\n  id         String   @id @default(cuid())\\n  sessionId  String\\n  orderIndex Int\\n  role       String\\n  content    String?\\n  rawJson    String\\n  archived   Boolean  @default(false)\\n  createdAt  DateTime @default(now())\\n  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)\\n\\n  @@unique([sessionId, orderIndex])\\n  @@index([sessionId, archived, orderIndex])\\n  @@index([sessionId, createdAt])\\n}\\n\\nmodel ToolCall {\\n  id            String   @id\\n  sessionId     String\\n  toolName      String\\n  status        String\\n  source        String?\\n  riskLevel     String?\\n  permissions   String?\\n  argsJson      String?\\n  resultSummary String?\\n  resultJson    String?\\n  errorMessage  String?\\n  startedAt     DateTime @default(now())\\n  finishedAt    DateTime?\\n  latencyMs     Int?\\n  createdAt     DateTime @default(now())\\n  updatedAt     DateTime @updatedAt\\n  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)\\n  auditLogs     AuditLog[]\\n\\n  @@index([sessionId, createdAt])\\n}\\n\\nmodel Checkpoint {\\n  id        String   @id @default(cuid())\\n  sessionId String\\n  threadId  String\\n  payload   String\\n  createdAt DateTime @default(now())\\n  updatedAt DateTime @updatedAt\\n  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)\\n\\n  @@unique([sessionId, threadId])\\n}\\n\\nmodel AuditLog {\\n  id            String   @id @default(cuid())\\n  sessionId     String?\\n  toolCallId    String?\\n  toolName      String\\n  source        String?\\n  url           String?\\n  riskLevel     String?\\n  permissions   String?\\n  status        String\\n  argsJson      String?\\n  resultSummary String?\\n  detail        String?\\n  latencyMs     Int?\\n  createdAt     DateTime @default(now())\\n  session       Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)\\n  toolCall      ToolCall? @relation(fields: [toolCallId], references: [id], onDelete: SetNull)\\n\\n  @@index([sessionId, createdAt])\\n  @@index([toolCallId, createdAt])\\n}\\n\\nmodel AgentTrace {\\n  id           String   @id @default(cuid())\\n  sessionId    String\\n  traceGroupId String\\n  agentName    String\\n  phase        String\\n  taskKind     String?\\n  message      String\\n  latencyMs    Int?\\n  toolCount    Int?\\n  detailJson   String?\\n  createdAt    DateTime @default(now())\\n  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)\\n\\n  @@index([sessionId, createdAt])\\n  @@index([traceGroupId, createdAt])\\n}\\n\"}"}
