generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String?   @unique
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]
}

model Session {
  id               String                 @id
  userId           String?
  title            String?
  summary          String?
  summaryUpdatedAt DateTime?
  messageCount     Int                    @default(0)
  lastMessageAt    DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  user             User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages         Message[]
  toolCalls        ToolCall[]
  checkpoints      Checkpoint[]
  auditLogs        AuditLog[]
  agentTraces      AgentTrace[]
  agentRuns        AgentRun[]
  agentSteps       AgentStep[]
  interruptEvents  InterruptEvent[]
  errorLogs        ErrorLog[]
  modelCalls       ModelCall[]
}

model ProjectMemory {
  id          String   @id @default(cuid())
  projectId   String
  type        String
  sourcePath  String?
  chunkKey    String
  title       String?
  content     String
  embedding   String
  metadataJson String?
  contentHash String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, chunkKey])
  @@index([projectId, type, updatedAt])
  @@index([projectId, sourcePath])
}

model Message {
  id         String   @id @default(cuid())
  sessionId  String
  orderIndex Int
  role       String
  content    String?
  rawJson    String
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, orderIndex])
  @@index([sessionId, archived, orderIndex])
  @@index([sessionId, createdAt])
}

model ToolCall {
  id            String   @id
  sessionId     String
  runId         String?
  stepId        String?
  toolName      String
  status        String
  source        String?
  riskLevel     String?
  permissions   String?
  approvedByUser Boolean?
  argsJson      String?
  resultSummary String?
  resultJson    String?
  errorMessage  String?
  estimatedCostUsd Float?
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  latencyMs     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  run           AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  step          AgentStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  auditLogs     AuditLog[]

  @@index([sessionId, createdAt])
  @@index([runId, createdAt])
  @@index([stepId, createdAt])
}

model Checkpoint {
  id        String   @id @default(cuid())
  sessionId String
  threadId  String
  payload   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, threadId])
}

model AuditLog {
  id            String   @id @default(cuid())
  sessionId     String?
  toolCallId    String?
  toolName      String
  source        String?
  url           String?
  riskLevel     String?
  permissions   String?
  status        String
  argsJson      String?
  resultSummary String?
  detail        String?
  latencyMs     Int?
  createdAt     DateTime @default(now())
  session       Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  toolCall      ToolCall? @relation(fields: [toolCallId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([toolCallId, createdAt])
}

model AgentTrace {
  id           String   @id @default(cuid())
  sessionId    String
  traceGroupId String
  agentName    String
  phase        String
  taskKind     String?
  message      String
  latencyMs    Int?
  toolCount    Int?
  detailJson   String?
  createdAt    DateTime @default(now())
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([traceGroupId, createdAt])
}

model AgentRun {
  id               String           @id
  sessionId        String?
  runtimeType      String
  trigger          String
  status           String
  entrypoint       String?
  latestUserTask   String?
  completionReason String?
  errorMessage     String?
  startedAt        DateTime         @default(now())
  finishedAt       DateTime?
  latencyMs        Int?
  session          Session?         @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  steps            AgentStep[]
  interrupts       InterruptEvent[]
  errorLogs        ErrorLog[]
  modelCalls       ModelCall[]
  toolCalls        ToolCall[]

  @@index([sessionId, startedAt])
  @@index([status, startedAt])
}

model AgentStep {
  id            String    @id @default(cuid())
  runId         String
  sessionId     String?
  agentName     String?
  nodeName      String
  status        String
  stepType      String
  inputSummary  String?
  outputSummary String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  latencyMs     Int?
  run           AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  session       Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  errors        ErrorLog[]
  interrupts    InterruptEvent[]
  modelCalls    ModelCall[]
  toolCalls     ToolCall[]

  @@index([runId, startedAt])
  @@index([sessionId, startedAt])
}

model InterruptEvent {
  id          String    @id @default(cuid())
  runId       String
  stepId      String?
  sessionId   String?
  kind        String
  status      String
  message     String?
  payloadJson String?
  reason      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  run         AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  step        AgentStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  session     Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([runId, createdAt])
  @@index([sessionId, createdAt])
}

model ErrorLog {
  id          String    @id @default(cuid())
  runId       String?
  stepId      String?
  sessionId   String?
  source      String
  message     String
  stack       String?
  contextJson String?
  createdAt   DateTime  @default(now())
  run         AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  step        AgentStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  session     Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([runId, createdAt])
  @@index([sessionId, createdAt])
}

model ModelCall {
  id                String    @id @default(cuid())
  runId             String
  stepId            String?
  sessionId         String?
  agentName         String?
  nodeName          String?
  provider          String
  model             String
  promptTokens      Int?
  completionTokens  Int?
  reasoningTokens   Int?
  estimatedCostUsd  Float?
  latencyMs         Int?
  status            String
  inputSummary      String?
  outputSummary     String?
  errorMessage      String?
  createdAt         DateTime  @default(now())
  finishedAt        DateTime?
  run               AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  step              AgentStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  session           Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([runId, createdAt])
  @@index([sessionId, createdAt])
}
