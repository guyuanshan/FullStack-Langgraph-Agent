00\";\n  if (message.toolStatus === \"error\") return \"bg-red-500\";\n  return \"bg-slate-400\";\n}\n\n/** 根据工具来源或名称返回一个图标 emoji */\nfunction getToolIcon(toolName?: string): string {\n  if (!toolName) return \"🔧\";\n  const name = toolName.toLowerCase();\n\n  if (name.startsWith(\"weather\")) return \"🌤️\";\n  if (name.startsWith(\"browser\")) return \"🌐\";\n  if (name.startsWith(\"github\")) return \"🐙\";\n  if (name.startsWith(\"fs\") || name.startsWith(\"file\")) return \"📁\";\n  if (name.startsWith(\"git\")) return \"🔀\";\n  if (name.startsWith(\"code\") || name.startsWith(\"project\")) return \"💻\";\n  if (name.startsWith(\"write\")) return \"✏️\";\n\n  return \"🛠️\";\n}\n\nfunction getBrowserResultData(value: unknown) {\n  if (!value || typeof value !== \"object\") {\n    return null;\n  }\n\n  const candidate = value as Record<string, unknown>;\n\n  return {\n    url: typeof candidate.url === \"string\" ? candidate.url : null,\n    title: typeof candidate.title === \"string\" ? candidate.title : null,\n    linksCount:\n      typeof candidate.linksCount === \"number\" ? candidate.linksCount : null,\n    previewDataUrl:\n      typeof candidate.previewDataUrl === \"string\"\n        ? candidate.previewDataUrl\n        : null,\n  };\n}\n\ntype PatchProposalFile = {\n  path: string;\n  diff: string;\n  originalContent: string;\n  proposedContent: string;\n};\n\nfunction getPatchProposalData(value: unknown) {\n  if (!value || typeof value !== \"object\") {\n    return null;\n  }\n\n  const candidate = value as Record<string, unknown>;\n\n  if (\n    candidate.kind !== \"patch_proposal\" ||\n    typeof candidate.proposalId !== \"string\" ||\n    !Array.isArray(candidate.files)\n  ) {\n    return null;\n  }\n\n  const files = candidate.files.filter(\n    (file): file is PatchProposalFile =>\n      !!file &&\n      typeof file === \"object\" &&\n      typeof (file as Record<string, unknown>).path === \"string\" &&\n      typeof (file as Record<string, unknown>).diff === \"string\" &&\n      typeof (file as Record<string, unknown>).originalContent === \"string\" &&\n      typeof (file as Record<string, unknown>).proposedContent === \"string\"\n  );\n\n  return {\n    proposalId: candidate.proposalId,\n    title: typeof candidate.title === \"string\" ? candidate.title : \"Patch proposal\",\n    summary: typeof candidate.summary === \"string\" ? candidate.summary : \"\",\n    status: typeof candidate.status === \"string\" ? candidate.status : \"pending\",\n    files,\n  };\n}\n\ntype PatchApplyResult = {\n  proposalId: string;\n  status: string;\n  backupDir?: string;\n  reason?: string;\n};\n\nfunction getPatchApplyResult(value: unknown): PatchApplyResult | null {\n  if (!value || typeof value !== \"object\") {\n    return null;\n  }\n\n  const candidate = value as Record<string, unknown>;\n\n  if (\n    candidate.kind !== \"patch_apply_result\" ||\n    typeof candidate.proposalId !== \"string\" ||\n    typeof candidate.status !== \"string\"\n  ) {\n    return null;\n  }\n\n  return {\n    proposalId: candidate.proposalId,\n    status: candidate.status,\n    backupDir:\n      typeof candidate.backupDir === \"string\" ? candidate.backupDir : undefined,\n    reason: typeof candidate.reason === \"string\" ? candidate.reason : undefined,\n  };\n}\n\ntype ToolCallCardProps = {\n  message: ChatMessage;\n  onConfirm?: (message: ChatMessage) => void;\n  onReject?: (message: ChatMessage) => void;\n  onApprovePatch?: (\n    message: ChatMessage,\n    files: Array<{ path: string; content: string }>\n  ) => void;\n  onRejectPatch?: (message: ChatMessage) => void;\n};\n\ntype PatchProposalEditorProps = {\n  message: ChatMessage;\n  patchProposal: {\n    proposalId: string;\n    title: string;\n    summary: string;\n    status: string;\n    files: PatchProposalFile[];\n  };\n  onApprovePatch?: (\n    message: ChatMessage,\n    files: Array<{ path: string; content: string }>\n  ) => void;\n  onRejectPatch?: (message: ChatMessage) => void;\n};\n\nfunction PatchProposalEditor({\n  message,\n  patchProposal,\n  onApprovePatch,\n  onRejectPatch,\n}: PatchProposalEditorProps) {\n  const [editedFiles, setEditedFiles] = useState(\n    patchProposal.files.map((file) => ({\n      path: file.path,\n      content: file.proposedContent,\n    }))\n  );\n\n  return (\n    <div className=\"mt-3 space-y-3\">\n      <div className=\"rounded-xl border border-slate-200 bg-slate-50 p-3\">\n        <p className=\"text-sm font-semibold text-slate-900\">{patchProposal.title}</p>\n        {patchProposal.summary ? (\n          <p className=\"mt-1 text-sm text-slate-700\">{patchProposal.summary}</p>\n        ) : null}\n        <p className=\"mt-2 text-xs text-slate-500\">\n          Proposal ID: {patchProposal.proposalId}\n        </p>\n      </div>\n\n      {patchProposal.files.map((file, index) => (\n        <div\n          key={file.path}\n          className=\"space-y-2 rounded-xl border border-slate-200 p-3\"\n        >\n          <p className=\"text-sm font-semibold text-slate-900\">{file.path}</p>\n          <pre className=\"overflow-x-auto rounded-xl bg-slate-950/95 p-3 text-xs leading-5 text-slate-100\">\n            {file.diff}\n          </pre>\n          <label className=\"block text-xs font-medium text-slate-500\">\n            Editable proposed content\n          </label>\n          <textarea\n            value={editedFiles[index]?.content ?? file.proposedContent}\n            onChange={(event) =>\n              setEditedFiles((current) =>\n                current.map((item, itemIndex) =>\n                  itemIndex === index\n                    ? {\n                        ...item,\n                        content: event.target.value,\n                      }\n                    : item\n                )\n              )\n            }\n            className=\"min-h-48 w-full rounded-xl border border-slate-200 bg-white p-3 font-mono text-xs leading-5 text-slate-900\"\n          />\n        </div>\n      ))}\n\n      <div className=\"flex gap-2\">\n        <button\n          type=\"button\"\n          onClick={() => onApprovePatch?.(message, editedFiles)}\n          className=\"rounded-lg bg-black px-3 py-2 text-sm text-white\"\n        >\n          应用补丁\n        </button>\n        <button\n          type=\"button\"\n          onClick={() => onRejectPatch?.(message)}\n          className=\"rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700\"\n        >\n          拒绝补丁\n        </button>\n      </div>\n    </div>\n  );\n}\n\nexport function ToolCallCard({\n  message,\n  onConfirm,\n  onReject,\n  onApprovePatch,\n  onRejectPatch,\n}: ToolCallCardProps) {\n  const resultLink = getResultLink(message.toolResult);\n  const browserResult = getBrowserResultData(message.toolResult);\n  const patchProposal = getPatchProposalData(message.toolResult);\n  const patchApplyResult = getPatchApplyResult(message.toolResult);\n  const previewDataUrl = browserResult?.previewDataUrl ?? null;\n  const linksCount = browserResult?.linksCount ?? null;\n\n  return (\n    <div className=\"max-w-[85%] rounded-2xl border border-slate-200 bg-white shadow-sm\">\n      {/* ===== 标题区：更醒目的头部 ===== */}\n      <div className=\"relative flex items-center gap-3 overflow-hidden rounded-t-2xl bg-gradient-to-r from-slate-50 to-white px-4 pb-3 pt-4\">\n        {/* 左侧状态色竖条装饰 */}\n        <div\n          className={`absolute left-0 top-0 h-full w-1 ${getStatusAccentColor(message)}`}\n        />\n\n        {/* 工具图标 */}\n        <span className=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-white text-base shadow-sm\">\n          {getToolIcon(message.toolName)}\n        </span>\n\n        {/* 工具名称 + 副标题 */}\n        <div className=\"min-w-0 flex-1\">\n          <p className=\"text-[11px] font-medium uppercase tracking-[0.15em] text-slate-400\">\n            Tool Call\n          </p>\n          <h3 className=\"truncate text-base font-bold text-slate-900\">\n            {message.toolName ?? \"Unknown tool\"}\n          </h3>\n        </div>\n\n        {/* 状态徽章（带圆点指示器） */}\n        <span\n          className={`inline-flex items-center gap-1.5 shrink-0 rounded-full border px-3 py-1 text-[11px] font-semibold ${getStatusClasses(\n            message\n          )}`}\n        >\n          <span\n            className={`inline-block h-1.5 w-1.5 rounded-full ${getStatusAccentColor(message)}`}\n          />\n          {getStatusLabel(message)}\n        </span>\n      </div>\n\n      {/* ===== 主体区域 ===== */}\n      <div className=\"px-4 pb-4\">\n        {message.toolArgs && (\n          <div className=\"mt-3\">\n            {message.toolSummary && (\n              <p className=\"mb-2 text-xs font-medium text-slate-500\">\n                Target: <span className=\"text-slate-800\">{message.toolSummary}</span>\n              </p>\n            )}\n\n            {(message.toolRiskLevel || message.toolPermissions?.length) && (\n              <p className=\"mb-2 text-xs font-medium text-slate-500\">\n                {message.toolRiskLevel ? `Risk: ${message.toolRiskLevel}` : \"\"}\n                {message.toolRiskLevel && message.toolPermissions?.length ? \" · \" : \"\"}\n                {message.toolPermissions?.length\n                  ? `Permissions: ${message.toolPermissions.join(\", \")}`\n                  : \"\"}\n              </p>\n            )}\n\n            <p className=\"mb-1 text-xs font-medium text-slate-500\">Arguments</p>\n            <pre className=\"overflow-x-auto rounded-xl bg-slate-950/95 p-3 text-xs leading-5 text-slate-100\">\n              {formatJson(message.toolArgs)}\n            </pre>\n          </div>\n        )}\n\n        {patchProposal && (\n          <PatchProposalEditor\n            key={patchProposal.proposalId}\n            message={message}\n            patchProposal={patchProposal}\n            onApprovePatch={onApprovePatch}\n            onRejectPatch={onRejectPatch}\n          />\n        )}\n\n        {message.toolResult !== undefined && !patchProposal && (\n          <div className=\"mt-3\">\n            <p className=\"mb-1 text-xs font-medium text-slate-500\">Result</p>\n            {browserResult?.url && (\n              <p className=\"mb-2 text-xs font-medium text-slate-500\">\n                URL: <span className=\"text-slate-800\">{browserResult.url}</span>\n              </p>\n            )}\n            {browserResult?.title && (\n              <p className=\"mb-2 text-xs font-medium text-slate-500\">\n                Title: <span className=\"text-slate-800\">{browserResult.title}</span>\n              </p>\n            )}\n            {linksCount !== null && (\n              <p className=\"mb-2 text-xs font-medium text-slate-500\">\n                Links: <span className=\"text-slate-800\">{linksCount}</span>\n              </p>\n            )}\n            {patchApplyResult?.backupDir && (\n              <p className=\"mb-2 text-xs font-medium text-slate-500\">\n                Backup: <span className=\"text-slate-800\">{patchApplyResult.backupDir}</span>\n              </p>\n            )}\n            {patchApplyResult?.reason && (\n              <p className=\"mb-2 text-xs font-medium text-slate-500\">\n                Reason: <span className=\"text-slate-800\">{patchApplyResult.reason}</span>\n              </p>\n            )}\n            {resultLink && (\n              <p className=\"mb-2 text-xs font-medium text-slate-500\">\n                Link:{\" \"}\n                <a\n                  href={resultLink}\n                  target=\"_blank\"\n                  rel=\"noreferrer\"\n                  className=\"text-blue-700 underline\"\n                >\n                  {resultLink}\n                </a>\n              </p>\n            )}\n            {previewDataUrl && (\n              <div className=\"mb-3 overflow-hidden rounded-xl border border-slate-200\">\n                <Image\n                  src={previewDataUrl}\n                  alt=\"Browser screenshot preview\"\n                  width={1200}\n                  height={800}\n                  unoptimized\n                  className=\"max-h-64 w-full object-cover\"\n                />\n              </div>\n            )}\n            <pre className=\"overflow-x-auto rounded-xl bg-slate-950/95 p-3 text-xs leading-5 text-slate-100\">\n              {formatJson(message.toolResult)}\n            </pre>\n          </div>\n        )}\n\n        {message.toolError && (\n          <div className=\"mt-3 rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700\">\n            {message.toolError}\n          </div>\n        )}\n\n        {message.toolStatus === \"confirm_required\" && (\n          <div className=\"mt-3 rounded-xl border border-blue-200 bg-blue-50 p-3\">\n            <p className=\"text-sm text-blue-900\">\n              {message.confirmMessage ??\n                \"This tool requires your approval before it can run.\"}\n            </p>\n            <div className=\"mt-3 flex gap-2\">\n              <button\n                type=\"button\"\n                onClick={() => onConfirm?.(message)}\n                className=\"rounded-lg bg-black px-3 py-2 text-sm text-white\"\n              >\n                允许执行\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => onReject?.(message)}\n                className=\"rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700\"\n              >\n                拒绝\n              </button>\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n"}]},"outcome":"success","resultSummary":"patch_25c9372d-60a7-4a03-9e89-264b8d176fb4 · 1 file(s)","detail":"{\"kind\":\"patch_proposal\",\"proposalId\":\"patch_25c9372d-60a7-4a03-9e89-264b8d176fb4\",\"title\":\"增强 ToolCallCard 标题区视觉层次\",\"summary\":\"重构 ToolCallCard 的标题区域，使其更醒目：① 左侧增加状态色竖条装饰；② 工具名称加大加粗；③ 状态徽章增加圆点指示器；④ 根据工具来源显示不同图标前缀；⑤ 标题区增加浅色背景衬托。\",\"status\":\"pending\",\"createdAt\":\"2026-05-19T05:37:56.967Z\",\"files\":[{\"path\":\"src/components/chat/ToolCallCard.tsx\",\"diff\":\"--- a/src/components/chat/ToolCallCard.tsx\\n+++ b/src/components/chat/ToolCallCard.tsx\\n@@ -49,6 +49,31 @@\\n   }\\n \\n   return \\\"border-slate-200 bg-slate-50 text-slate-900\\\";\\n+}\\n+\\n+/** 获取状态对应的主题色（用于强调条和圆点） */\\n+function getStatusAccentColor(message: ChatMessage): string {\\n+  if (message.toolStatus === \\\"running\\\") return \\\"bg-amber-500\\\";\\n+  if (message.toolStatus === \\\"confirm_required\\\") return \\\"bg-blue-500\\\";\\n+  if (message.toolStatus === \\\"success\\\") return \\\"bg-emerald-500\\\";\\n+  if (message.toolStatus === \\\"error\\\") return \\\"bg-red-500\\\";\\n+  return \\\"bg-slate-400\\\";\\n+}\\n+\\n+/** 根据工具来源或名称返回一个图标 emoji */\\n+function getToolIcon(toolName?: string): string {\\n+  if (!toolName) return \\\"🔧\\\";\\n+  const name = toolName.toLowerCase();\\n+\\n+  if (name.startsWith(\\\"weather\\\")) return \\\"🌤️\\\";\\n+  if (name.startsWith(\\\"browser\\\")) return \\\"🌐\\\";\\n+  if (name.startsWith(\\\"github\\\")) return \\\"🐙\\\";\\n+  if (name.startsWith(\\\"fs\\\") || name.startsWith(\\\"file\\\")) return \\\"📁\\\";\\n+  if (name.startsWith(\\\"git\\\")) return \\\"🔀\\\";\\n+  if (name.startsWith(\\\"code\\\") || name.startsWith(\\\"project\\\")) return \\\"💻\\\";\\n+  if (name.startsWith(\\\"write\\\")) return \\\"✏️\\\";\\n+\\n+  return \\\"🛠️\\\";\\n }\\n \\n function getBrowserResultData(value: unknown) {\\n@@ -260,150 +285,169 @@\\n   const linksCount = browserResult?.linksCount ?? null;\\n \\n   return (\\n-    <div className=\\\"max-w-[85%] rounded-2xl border border-slate-200 bg-white p-4 shadow-sm\\\">\\n-      <div className=\\\"flex items-center justify-between gap-3\\\">\\n-        <div>\\n-          <p className=\\\"text-xs font-medium uppercase tracking-[0.18em] text-slate-500\\\">\\n+    <div className=\\\"max-w-[85%] rounded-2xl