ete: SetNull)\\n\\n  @@index([sessionId, createdAt])\\n  @@index([toolCallId, createdAt])\\n}\\n\\nmodel AgentTrace {\\n  id           String   @id @default(cuid())\\n  sessionId    String\\n  traceGroupId String\\n  agentName    String\\n  phase        String\\n  taskKind     String?\\n  message      String\\n  latencyMs    Int?\\n  toolCount    Int?\\n  detailJson   String?\\n  createdAt    DateTime @default(now())\\n  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)\\n\\n  @@index([sessionId, createdAt])\\n  @@index([traceGroupId, createdAt])\\n}\\n\"}"}
